// Glint settings, shown as an overlay inside the editor window (owner, 2026-11-12): a dimmed
// backdrop and a card with a section list on the left (mockup #3 in
// docs/mockups/2026-11-12-settings-layouts.html). The options were chosen with the owner one by
// one; values and callbacks live in the SettingsState global, filled and saved by settings.rs.

import { Theme } from "theme.slint";

export global SettingsState {
    in-out property <int> section: 0;
    in-out property <bool> hdr-capture;
    in-out property <bool> capture-sound;
    in-out property <int> preview-seconds: 6;
    in-out property <[string]> hk-region;
    in-out property <[string]> hk-fullscreen;
    in-out property <[string]> hk-repeat;
    in-out property <string> save-dir;
    // "png", "jpg" or "webp".
    in-out property <string> save-format: "png";
    // "system", "light" or "dark".
    in-out property <string> theme: "system";
    in-out property <bool> start-with-windows;
    in-out property <string> version;
    in-out property <string> note;

    // A toggle, stepper or choice changed: settings.rs reads the state and saves config.toml.
    callback changed();
    callback start-with-windows-changed(bool);
    callback hotkey-changed(string, string);
    callback record-hotkey(string, bool, bool, bool, bool) -> string;
    callback browse-folder();
    callback open-folder();
    callback open-website();
    callback close();
}

component Toggle inherits Rectangle {
    in-out property <bool> on;
    callback toggled(bool);
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: root.on ? Theme.accent : Theme.dark ? #ffffff2e : #0000002e;
    animate background { duration: 160ms; }
    Rectangle {
        x: root.on ? 21px : 3px;
        y: 3px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000055;
        animate x { duration: 200ms; easing: cubic-bezier(0.3, 1.4, 0.5, 1); }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// A segmented choice: the options are labels, `value` is the chosen one's key.
component Choice inherits Rectangle {
    in property <[{key: string, label: string}]> options;
    in-out property <string> value;
    callback picked(string);
    height: 32px;
    width: row.preferred-width + 6px;
    border-radius: 8px;
    background: Theme.dark ? #ffffff0d : #0000000a;
    border-width: 1px;
    border-color: Theme.panel-edge;
    row := HorizontalLayout {
        x: 3px;
        y: 3px;
        height: 26px;
        spacing: 2px;
        for o in root.options: Rectangle {
            width: t.preferred-width + 22px;
            border-radius: 6px;
            background: root.value == o.key ? Theme.accent : ta.has-hover ? Theme.hover : transparent;
            t := Text {
                text: o.label;
                font-size: 12.5px;
                font-weight: 600;
                color: root.value == o.key ? #ffffff : Theme.text;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.value = o.key;
                    root.picked(o.key);
                }
            }
        }
    }
}

// One setting: icon, name, one line of help, and its control on the right.
component Row inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> help;
    in property <bool> last;
    min-height: 62px;
    HorizontalLayout {
        spacing: 14px;
        alignment: stretch;
        Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: Theme.accent.with-alpha(Theme.dark ? 0.18 : 0.13);
            Image {
                source: root.icon;
                width: 17px;
                height: 17px;
                colorize: Theme.dark ? #a78bfa : #7c3aed;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: root.help;
                font-size: 12.5px;
                color: Theme.dim-text;
                wrap: word-wrap;
            }
        }
        @children
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.sep;
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    callback clicked;
    height: 28px;
    width: t.preferred-width + 22px;
    border-radius: 7px;
    background: ta.has-hover ? Theme.hover.mix(Theme.pill, 0.5) : Theme.pill;
    border-width: 1px;
    border-color: Theme.panel-edge;
    t := Text {
        text: root.label;
        font-size: 12.5px;
        font-weight: 600;
        color: Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Shows a hotkey as key caps; click it, then press the new keys. Esc cancels, Backspace clears.
component HotkeyField inherits Rectangle {
    in property <[string]> keys;
    callback changed(string);
    property <bool> recording: fs.has-focus;
    height: 34px;
    width: max(150px, row.preferred-width + 12px);
    border-radius: 8px;
    background: Theme.dark ? #ffffff0d : #0000000a;
    border-width: root.recording ? 2px : 1px;
    border-color: root.recording ? Theme.accent : Theme.panel-edge;
    row := HorizontalLayout {
        x: 6px;
        spacing: 4px;
        alignment: start;
        if root.recording: Text {
            text: "Press keys…";
            color: Theme.accent;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        if !root.recording && root.keys.length == 0: Text {
            text: "Not set";
            color: Theme.dim-text;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        for k in (root.recording ? [] : root.keys): Rectangle {
            y: (34px - 24px) / 2;
            height: 24px;
            width: k == "Win" ? 28px : max(24px, kt.preferred-width + 14px);
            border-radius: 5px;
            background: Theme.pill;
            border-width: 1px;
            border-color: Theme.panel-edge;
            kt := Text {
                visible: k != "Win";
                text: k;
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
            }
            // The Win key as its logo: four panes.
            if k == "Win": Rectangle {
                width: 13px;
                height: 13px;
                Rectangle { x: 0; y: 0; width: 6px; height: 6px; background: Theme.text; }
                Rectangle { x: 7px; y: 0; width: 6px; height: 6px; background: Theme.text; }
                Rectangle { x: 0; y: 7px; width: 6px; height: 6px; background: Theme.text; }
                Rectangle { x: 7px; y: 7px; width: 6px; height: 6px; background: Theme.text; }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if !root.recording {
                return reject;
            }
            let r = SettingsState.record-hotkey(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            if r == "cancel" {
                fs.clear-focus();
            } else if r != "" {
                root.changed(r);
                fs.clear-focus();
            }
            accept
        }
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <int> index;
    property <bool> active: SettingsState.section == root.index;
    height: 36px;
    border-radius: 7px;
    background: root.active ? Theme.hover : ta.has-hover ? Theme.hover.with-alpha(0.05) : transparent;
    if root.active: Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 12px;
        Image {
            source: root.icon;
            width: 17px;
            height: 17px;
            y: (36px - 17px) / 2;
            colorize: Theme.dim-text;
        }
        Text {
            text: root.label;
            font-size: 13.5px;
            font-weight: root.active ? 600 : 400;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { SettingsState.section = root.index; }
    }
}

// The overlay: fills its parent (the editor window).
export component SettingsPanel inherits Rectangle {
    // From the tray with no picture: a plain backdrop instead of the dimmed editor.
    in property <bool> solid;
    background: root.solid ? Theme.bg : #00000080;
    TouchArea {
        clicked => { SettingsState.close(); }
    }
    card := Rectangle {
        width: min(880px, parent.width - 48px);
        height: min(580px, parent.height - 48px);
        border-radius: 14px;
        background: Theme.dark ? #1a1a1f : #fbfbfd;
        border-width: 1px;
        border-color: Theme.panel-edge;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        // Swallow clicks inside the card (only the backdrop closes it).
        TouchArea { }
        HorizontalLayout {
            // Section list.
            Rectangle {
                width: 220px;
                border-top-left-radius: 14px;
                border-bottom-left-radius: 14px;
                background: Theme.dark ? #16161b : #f2f2f6;
                VerticalLayout {
                    padding: 14px;
                    padding-top: 20px;
                    spacing: 2px;
                    Text {
                        text: "Settings";
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.dim-text;
                        horizontal-alignment: left;
                    }
                    Rectangle { height: 8px; }
                    NavItem { icon: @image-url("icons/settings.svg"); label: "General"; index: 0; }
                    NavItem { icon: @image-url("icons/keyboard.svg"); label: "Hotkeys"; index: 1; }
                    NavItem { icon: @image-url("icons/folder.svg"); label: "Saving"; index: 2; }
                    Rectangle { vertical-stretch: 1; }
                    NavItem { icon: @image-url("icons/info.svg"); label: "About"; index: 3; }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.sep;
                }
            }
            // The section.
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-top: 22px;
                    spacing: 4px;
                    alignment: start;
                    Text {
                        property <int> s: SettingsState.section;
                        text: self.s == 0 ? "General" : self.s == 1 ? "Hotkeys" : self.s == 2 ? "Saving" : "About";
                        font-size: 24px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Rectangle { height: 10px; }

                    if SettingsState.section == 0: VerticalLayout {
                        Row {
                            icon: @image-url("icons/sound.svg");
                            title: "Capture sound";
                            help: "A camera shutter when a snip is taken";
                            Toggle { y: 19px; on <=> SettingsState.capture-sound; toggled => { SettingsState.changed(); } }
                        }
                        Row {
                            icon: @image-url("icons/timer.svg");
                            title: "Preview card";
                            help: "Seconds the card stays in the corner (it waits while the mouse is on it)";
                            Rectangle {
                                width: 116px;
                                height: 34px;
                                y: 14px;
                                border-radius: 8px;
                                background: Theme.dark ? #ffffff0d : #0000000a;
                                border-width: 1px;
                                border-color: Theme.panel-edge;
                                HorizontalLayout {
                                    Rectangle {
                                        width: 34px;
                                        Image { source: @image-url("icons/minus.svg"); width: 15px; height: 15px; colorize: Theme.text; }
                                        TouchArea { mouse-cursor: pointer; clicked => { SettingsState.preview-seconds = max(1, SettingsState.preview-seconds - 1); SettingsState.changed(); } }
                                    }
                                    Text {
                                        text: SettingsState.preview-seconds + " s";
                                        font-size: 13.5px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 34px;
                                        Image { source: @image-url("icons/plus.svg"); width: 15px; height: 15px; colorize: Theme.text; }
                                        TouchArea { mouse-cursor: pointer; clicked => { SettingsState.preview-seconds = min(60, SettingsState.preview-seconds + 1); SettingsState.changed(); } }
                                    }
                                }
                            }
                        }
                        Row {
                            icon: @image-url("icons/hdr.svg");
                            title: "HDR capture";
                            help: "Better colours on HDR screens (games, video), a little slower";
                            Toggle { y: 19px; on <=> SettingsState.hdr-capture; toggled => { SettingsState.changed(); } }
                        }
                        Row {
                            icon: @image-url("icons/frame.svg");
                            title: "Theme";
                            help: "Light or dark, or follow the Windows setting";
                            Choice {
                                y: 15px;
                                options: [{ key: "system", label: "Windows" }, { key: "light", label: "Light" }, { key: "dark", label: "Dark" }];
                                value <=> SettingsState.theme;
                                picked => { SettingsState.changed(); }
                            }
                        }
                        Row {
                            icon: @image-url("icons/power.svg");
                            title: "Start with Windows";
                            help: "Glint waits in the tray, using about 2 MB of memory";
                            last: true;
                            Toggle { y: 19px; on <=> SettingsState.start-with-windows; toggled(v) => { SettingsState.start-with-windows-changed(v); } }
                        }
                    }
                    if SettingsState.section == 1: VerticalLayout {
                        Row {
                            icon: @image-url("icons/keyboard.svg");
                            title: "Snip";
                            help: "Opens the snip overlay; press it again to cancel";
                            HotkeyField { y: 14px; keys: SettingsState.hk-region; changed(v) => { SettingsState.hotkey-changed("region", v); } }
                        }
                        Row {
                            icon: @image-url("icons/frame.svg");
                            title: "Full screen";
                            help: "Snips the screen under the cursor at once";
                            HotkeyField { y: 14px; keys: SettingsState.hk-fullscreen; changed(v) => { SettingsState.hotkey-changed("fullscreen", v); } }
                        }
                        Row {
                            icon: @image-url("icons/redo.svg");
                            title: "Repeat last area";
                            help: "Snips the same area again";
                            last: true;
                            HotkeyField { y: 14px; keys: SettingsState.hk-repeat; changed(v) => { SettingsState.hotkey-changed("repeat", v); } }
                        }
                        Text {
                            text: "Click a field and press the keys. Esc cancels, Backspace clears.";
                            font-size: 12px;
                            color: Theme.dim-text;
                            wrap: word-wrap;
                        }
                    }
                    if SettingsState.section == 2: VerticalLayout {
                        Row {
                            icon: @image-url("icons/folder.svg");
                            title: "Save folder";
                            help: SettingsState.save-dir;
                            HorizontalLayout {
                                spacing: 6px;
                                SmallButton { y: 17px; label: "Change"; clicked => { SettingsState.browse-folder(); } }
                                SmallButton { y: 17px; label: "Open"; clicked => { SettingsState.open-folder(); } }
                            }
                        }
                        Row {
                            icon: @image-url("icons/save.svg");
                            title: "Save format";
                            help: "The format Save starts with; you can still pick another";
                            last: true;
                            Choice {
                                y: 15px;
                                options: [{ key: "png", label: "PNG" }, { key: "jpg", label: "JPEG" }, { key: "webp", label: "WebP" }];
                                value <=> SettingsState.save-format;
                                picked => { SettingsState.changed(); }
                            }
                        }
                    }
                    if SettingsState.section == 3: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "Glint " + SettingsState.version;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: "A small snipping tool for Windows. MIT licence.";
                            font-size: 13px;
                            color: Theme.dim-text;
                        }
                        HorizontalLayout {
                            alignment: start;
                            SmallButton { label: "Website"; clicked => { SettingsState.open-website(); } }
                        }
                    }
                    if SettingsState.note != "": Text {
                        text: SettingsState.note;
                        font-size: 12px;
                        color: #ef4444;
                        wrap: word-wrap;
                    }
                }
            }
        }
        // Close.
        Rectangle {
            x: parent.width - 44px;
            y: 12px;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: cl.has-hover ? Theme.hover : transparent;
            Text {
                text: "✕";
                font-size: 14px;
                color: Theme.dim-text;
            }
            cl := TouchArea {
                mouse-cursor: pointer;
                clicked => { SettingsState.close(); }
            }
        }
    }
}
