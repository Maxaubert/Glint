// The Glint editor window: a toolbar, the canvas, and a status line.
// All drawing happens in Rust (tiny-skia); this file only lays out and forwards input.

export struct ToolItem {
    id: string,
    glyph: string,
    tip: string,
    key: string,
}

// The crop frame in parts (0..1) of the shown image.
export struct CropFrame {
    show: bool,
    x0: float,
    y0: float,
    x1: float,
    y1: float,
    grid: bool,
}

// A white handle bar with a thin dark edge, so it shows on white and on dark images.
component CropBar inherits Rectangle {
    background: #00000099;
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        background: #ffffff;
    }
}

// A thirds-grid line: white with a dark line beside it.
component GridLine inherits Rectangle {
    in property <bool> vertical;
    background: #ffffffb0;
    Rectangle {
        x: root.vertical ? 1px : 0;
        y: root.vertical ? 0 : 1px;
        width: root.vertical ? 1px : parent.width;
        height: root.vertical ? parent.height : 1px;
        background: #00000059;
    }
}

global Theme {
    out property <color> bg: #141417;
    out property <color> bar: #1f1f24;
    out property <color> hover: #ffffff17;
    out property <color> accent: #8b5cf6;
    out property <color> text: #ececf1;
    out property <color> dim-text: #9a9aa6;
    out property <color> tip-bg: #2a2a31;
    out property <string> icons: "Segoe Fluent Icons";
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;
    in property <string> key;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    callback hovered(string, string, length);
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: root.active ? Theme.accent : (ta.has-hover && root.enabled ? Theme.hover : transparent);
    Text {
        text: root.glyph;
        font-family: Theme.icons;
        font-size: 15px;
        color: root.enabled ? Theme.text : #ececf150;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover ? root.tip : "", root.key, root.absolute-position.x + root.width / 2); }
    }
}

component TextButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    // Copy button: the icon turns into a checkmark and the label says what happened.
    in property <bool> done;
    in property <string> done-label;
    in property <string> tip;
    in property <string> key;
    in property <bool> primary;
    callback clicked;
    callback hovered(string, string, length);
    height: 34px;
    border-radius: 6px;
    background: root.done ? #22c55e2e : root.primary ? (ta.has-hover ? #9d74f7 : Theme.accent) : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: 200ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        Rectangle {
            width: 16px;
            Text {
                text: root.glyph;
                font-family: Theme.icons;
                font-size: root.done ? 6px : 14px;
                opacity: root.done ? 0 : 1;
                animate font-size, opacity { duration: 160ms; easing: ease-in; }
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                text: "\u{E73E}";
                font-family: Theme.icons;
                font-size: root.done ? 15px : 4px;
                opacity: root.done ? 1 : 0;
                animate font-size { duration: 320ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                animate opacity { duration: 160ms; }
                color: #4ade80;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.done && root.done-label != "" ? root.done-label : root.label;
            font-size: 13px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover ? root.tip : "", root.key, root.absolute-position.x + root.width / 2); }
    }
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> active;
    in property <string> tip;
    in property <string> key;
    callback clicked;
    callback hovered(string, string, length);
    width: 26px;
    height: 34px;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.swatch;
        border-width: root.active ? 2px : 1px;
        border-color: root.active ? Theme.text : #ffffff40;
    }
    TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover ? root.tip : "", root.key, root.absolute-position.x + root.width / 2); }
    }
}

component Separator inherits Rectangle {
    width: 1px;
    height: 22px;
    background: #ffffff1c;
}

export component EditorWindow inherits Window {
    icon: @image-url("../../../assets/glint-256.png");
    in property <string> window-title: "Glint";
    title: root.window-title;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    min-width: 980px;
    min-height: 360px;

    in property <[ToolItem]> tools;
    in property <[color]> palette;
    in property <image> canvas;
    in property <int> img-w: 1;
    in property <int> img-h: 1;
    in property <string> tool;
    in property <int> color-index;
    in property <int> size-index;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <string> status;
    property <bool> status-visible;
    // The Copy button shows a checkmark for a moment after a copy.
    property <bool> copied;
    public function show-copied() {
        root.copied = false;
        root.copied = true;
    }
    Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
    changed status => { root.status-visible = root.status != ""; }
    in property <string> cursor: "cross";
    // Pen and highlighter: an outlined circle as wide as the stroke replaces the cursor
    // (display pixels of the visible area; 0 = none).
    in property <float> brush;
    in property <bool> crop-pending;
    in property <CropFrame> crop-frame;
    // Crop settle animation (main.rs settle_crop): the cropped image starts where the frame was
    // and zooms to its fitted place.
    in-out property <bool> settling;
    in-out property <bool> settle-anim;
    property <length> settle-x;
    property <length> settle-y;
    property <length> settle-w;
    property <length> settle-h;
    public function begin-settle(fx: float, fy: float, fw: float, fh: float) {
        root.settle-x = img.x + fx * img.width;
        root.settle-y = img.y + fy * img.height;
        root.settle-w = fw * img.width;
        root.settle-h = fh * img.height;
        root.settle-anim = false;
        root.settling = true;
    }

    // On-canvas text box (image pixel coordinates of its top-left, and font size in image pixels).
    in-out property <bool> text-editing;
    in property <float> text-x;
    in property <float> text-y;
    in property <float> text-size;
    in property <color> text-color;
    in-out property <string> text-value;

    callback tool-selected(string);
    callback color-selected(int);
    callback size-step(int);
    callback action(string);
    // kind: "down", "move", "up"; x, y in image pixels of the visible area.
    callback pointer(string, float, float, bool, bool, bool);
    callback double-click(float, float);
    callback key(string, bool, bool, bool) -> bool;
    callback commit-text(string);

    public function focus-canvas() {
        keys.focus();
    }
    public function focus-text() {
        ti.focus();
        ti.select-all();
    }

    // Tooltip under the hovered toolbar button. It appears after a short pause; moving to the
    // next button within the hide delay keeps it up and just moves it.
    property <string> tip-name;
    property <string> tip-key;
    property <length> tip-x;
    property <bool> tip-want;
    property <bool> tip-shown;
    function hover-tip(name: string, key: string, x: length) {
        if name != "" {
            root.tip-name = name;
            root.tip-key = key;
            root.tip-x = x;
            root.tip-want = true;
        } else {
            root.tip-want = false;
        }
    }
    // Tests only (see main.rs, F11).
    public function show-tip(name: string, key: string, x: float) {
        root.hover-tip(name, key, x * 1px);
        root.tip-shown = true;
    }
    Timer {
        interval: 3s;
        running: root.status-visible;
        triggered => { root.status-visible = false; }
    }
    Timer {
        interval: 450ms;
        running: root.tip-want && !root.tip-shown;
        triggered => { root.tip-shown = true; }
    }
    Timer {
        interval: 150ms;
        running: !root.tip-want && root.tip-shown;
        triggered => { root.tip-shown = false; }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Toolbar
            Rectangle {
                height: 50px;
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: stretch;
                    for t in root.tools: IconButton {
                        y: 8px;
                        glyph: t.glyph;
                        tip: t.tip;
                        key: t.key;
                        active: root.tool == t.id;
                        clicked => {
                            root.tool-selected(t.id);
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    Rectangle {
                        width: 10px;
                        Separator { }
                    }
                    for c[i] in root.palette: Swatch {
                        y: 8px;
                        swatch: c;
                        active: i == root.color-index;
                        tip: "Colour";
                        key: i + 1;
                        clicked => {
                            root.color-selected(i);
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    Rectangle {
                        width: 10px;
                        Separator { }
                    }
                    IconButton {
                        y: 8px;
                        glyph: "\u{E949}";
                        tip: "Thinner";
                        key: "[";
                        clicked => {
                            root.size-step(-1);
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    Rectangle {
                        width: 26px;
                        Rectangle {
                            property <length> d: 4px + root.size-index * 3px;
                            width: self.d;
                            height: self.d;
                            border-radius: self.d / 2;
                            background: root.palette[root.color-index];
                        }
                    }
                    IconButton {
                        y: 8px;
                        glyph: "\u{E948}";
                        tip: "Thicker";
                        key: "]";
                        clicked => {
                            root.size-step(1);
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        y: 8px;
                        glyph: "\u{E7A7}";
                        tip: "Undo";
                        key: "Ctrl+Z";
                        enabled: root.can-undo;
                        clicked => {
                            root.action("undo");
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    IconButton {
                        y: 8px;
                        glyph: "\u{E7A6}";
                        tip: "Redo";
                        key: "Ctrl+Y";
                        enabled: root.can-redo;
                        clicked => {
                            root.action("redo");
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    Rectangle {
                        width: 10px;
                        Separator { }
                    }
                    TextButton {
                        y: 8px;
                        glyph: "\u{E8C8}";
                        label: "Copy";
                        done: root.copied;
                        done-label: "Copied";
                        tip: "Copy to the clipboard";
                        key: "Ctrl+C";
                        clicked => {
                            root.action("copy");
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                    Rectangle {
                        width: 4px;
                    }
                    TextButton {
                        y: 8px;
                        glyph: "\u{E74E}";
                        label: "Save";
                        tip: "Save as PNG, JPEG or WebP";
                        key: "Ctrl+S";
                        primary: true;
                        clicked => {
                            root.action("save");
                            keys.focus();
                        }
                        hovered(n, k, x) => { root.hover-tip(n, k, x); }
                    }
                }
            }

            // Canvas
            area := Rectangle {
                background: Theme.bg;
                clip: true;
                // Show at 100 % (one image pixel per screen pixel) when it fits, else shrink to fit.
                property <float> fit: min(1, min((self.width - 24px) / (root.img-w * 1phx), (self.height - 24px) / (root.img-h * 1phx)));
                img := Image {
                    source: root.canvas;
                    width: root.settling ? root.settle-w : root.img-w * 1phx * area.fit;
                    height: root.settling ? root.settle-h : root.img-h * 1phx * area.fit;
                    x: root.settling ? root.settle-x : (parent.width - root.img-w * 1phx * area.fit) / 2;
                    y: root.settling ? root.settle-y : (parent.height - root.img-h * 1phx * area.fit) / 2;
                    animate x, y, width, height {
                        duration: root.settle-anim ? 280ms : 0ms;
                        easing: ease-in-out;
                    }
                    image-rendering: area.fit >= 1 ? pixelated : smooth;

                    ta := TouchArea {
                        property <float> ix: self.mouse-x / max(1px, self.width) * root.img-w;
                        property <float> iy: self.mouse-y / max(1px, self.height) * root.img-h;
                        mouse-cursor: root.cursor == "move" ? MouseCursor.move : root.cursor == "nwse" ? MouseCursor.nwse-resize : root.cursor == "nesw" ? MouseCursor.nesw-resize : root.cursor == "ew" ? MouseCursor.ew-resize : root.cursor == "ns" ? MouseCursor.ns-resize : root.cursor == "text" ? MouseCursor.text : root.cursor == "default" ? MouseCursor.default : root.cursor == "none" ? MouseCursor.none : MouseCursor.crosshair;
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                keys.focus();
                                root.pointer("down", self.ix, self.iy, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                                root.pointer("up", self.ix, self.iy, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                            } else if e.kind == PointerEventKind.move {
                                root.pointer("move", self.ix, self.iy, e.modifiers.shift, e.modifiers.control, e.modifiers.alt);
                            }
                        }
                        double-clicked => {
                            root.double-click(self.ix, self.iy);
                        }
                    }

                    // Crop frame, iOS style. Drawn here in window pixels, not into the picture:
                    // shrinking a picture to fit drops its last rows, which hid the bottom line,
                    // and the lines keep one thickness at any zoom.
                    if root.crop-frame.show: cf := Rectangle {
                        property <length> l: root.crop-frame.x0 * img.width;
                        property <length> t: root.crop-frame.y0 * img.height;
                        property <length> r: root.crop-frame.x1 * img.width;
                        property <length> b: root.crop-frame.y1 * img.height;
                        property <length> th: 5px;
                        property <length> len: max(self.th * 2, min(22px, min((self.r - self.l) / 3, (self.b - self.t) / 3)));
                        x: 0;
                        y: 0;
                        width: img.width;
                        height: img.height;
                        // Dim outside the frame.
                        Rectangle { x: 0; y: 0; width: parent.width; height: parent.t; background: #0000008c; }
                        Rectangle { x: 0; y: parent.b; width: parent.width; height: parent.height - parent.b; background: #0000008c; }
                        Rectangle { x: 0; y: parent.t; width: parent.l; height: parent.b - parent.t; background: #0000008c; }
                        Rectangle { x: parent.r; y: parent.t; width: parent.width - parent.r; height: parent.b - parent.t; background: #0000008c; }
                        // Thirds grid while dragging.
                        for k in (root.crop-frame.grid ? [1, 2] : []): GridLine {
                            vertical: true;
                            x: parent.l + (parent.r - parent.l) * k / 3 - 1px;
                            y: parent.t;
                            width: 1px;
                            height: parent.b - parent.t;
                        }
                        for k in (root.crop-frame.grid ? [1, 2] : []): GridLine {
                            x: parent.l;
                            y: parent.t + (parent.b - parent.t) * k / 3 - 1px;
                            width: parent.r - parent.l;
                            height: 1px;
                        }
                        // Frame line on a soft dark line.
                        Rectangle {
                            x: parent.l;
                            y: parent.t;
                            width: parent.r - parent.l;
                            height: parent.b - parent.t;
                            border-width: 3px;
                            border-color: #0000006e;
                        }
                        Rectangle {
                            x: parent.l;
                            y: parent.t;
                            width: parent.r - parent.l;
                            height: parent.b - parent.t;
                            border-width: 1.5px;
                            border-color: #ffffffeb;
                        }
                        // Corners.
                        CropBar { x: parent.l; y: parent.t; width: parent.len; height: parent.th; }
                        CropBar { x: parent.l; y: parent.t; width: parent.th; height: parent.len; }
                        CropBar { x: parent.r - parent.len; y: parent.t; width: parent.len; height: parent.th; }
                        CropBar { x: parent.r - parent.th; y: parent.t; width: parent.th; height: parent.len; }
                        CropBar { x: parent.l; y: parent.b - parent.th; width: parent.len; height: parent.th; }
                        CropBar { x: parent.l; y: parent.b - parent.len; width: parent.th; height: parent.len; }
                        CropBar { x: parent.r - parent.len; y: parent.b - parent.th; width: parent.len; height: parent.th; }
                        CropBar { x: parent.r - parent.th; y: parent.b - parent.len; width: parent.th; height: parent.len; }
                        // Edge bars, when the edge is long enough.
                        if cf.r - cf.l > cf.len * 4: CropBar {
                            x: (parent.l + parent.r - parent.len) / 2; y: parent.t; width: parent.len; height: parent.th;
                        }
                        if cf.r - cf.l > cf.len * 4: CropBar {
                            x: (parent.l + parent.r - parent.len) / 2; y: parent.b - parent.th; width: parent.len; height: parent.th;
                        }
                        if cf.b - cf.t > cf.len * 4: CropBar {
                            x: parent.l; y: (parent.t + parent.b - parent.len) / 2; width: parent.th; height: parent.len;
                        }
                        if cf.b - cf.t > cf.len * 4: CropBar {
                            x: parent.r - parent.th; y: (parent.t + parent.b - parent.len) / 2; width: parent.th; height: parent.len;
                        }
                    }

                    // Brush outline: a white ring inside a dark one, readable on any image.
                    if root.brush > 0 && root.cursor == "none" && ta.has-hover: Rectangle {
                        property <length> d: max(6px, root.brush / root.img-w * img.width);
                        x: ta.mouse-x - self.width / 2;
                        y: ta.mouse-y - self.height / 2;
                        width: self.d + 2px;
                        height: self.d + 2px;
                        border-radius: self.width / 2;
                        border-width: 1px;
                        border-color: #00000099;
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            width: parent.d;
                            height: parent.d;
                            border-radius: parent.d / 2;
                            border-width: 1.5px;
                            border-color: #ffffffe6;
                        }
                    }
                }

                // Image size, small and dim in the bottom-right corner (no status bar).
                Text {
                    x: parent.width - self.width - 12px;
                    y: parent.height - self.height - 6px;
                    text: root.img-w + " \u{00D7} " + root.img-h;
                    color: #9a9aa6b0;
                    font-size: 11px;
                }
                // Results of actions (copied, saved, errors), bottom-left, gone after a few seconds.
                Text {
                    x: 12px;
                    y: parent.height - self.height - 6px;
                    width: parent.width - 160px;
                    text: root.status;
                    visible: root.status-visible;
                    overflow: elide;
                    color: Theme.dim-text;
                    font-size: 11px;
                }

                // The text box sits over the canvas where the text will go.
                Rectangle {
                    visible: root.text-editing;
                    x: img.x + root.text-x / root.img-w * img.width - 4px;
                    y: img.y + root.text-y / root.img-h * img.height - 2px;
                    width: max(80px, ti.preferred-width + 12px);
                    height: ti.preferred-height + 4px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    border-radius: 3px;
                    background: transparent;
                    ti := TextInput {
                        x: 4px;
                        y: 2px;
                        text <=> root.text-value;
                        color: root.text-color;
                        font-family: "Segoe UI";
                        font-size: max(8px, root.text-size / root.img-w * img.width);
                        single-line: true;
                        accepted => {
                            root.commit-text(self.text);
                            keys.focus();
                        }
                    }
                }
            }
        }
        // The tooltip, drawn over everything.
        tooltip := Rectangle {
            property <length> w: tip-row.preferred-width;
            x: clamp(root.tip-x - self.w / 2, 6px, root.width - self.w - 6px);
            y: root.tip-shown ? 55px : 51px;
            width: self.w;
            height: 30px;
            opacity: root.tip-shown ? 1 : 0;
            animate opacity { duration: 120ms; easing: ease-out; }
            animate y { duration: 120ms; easing: ease-out; }
            animate x { duration: root.tip-shown ? 90ms : 0ms; easing: ease-out; }
            border-radius: 8px;
            background: Theme.tip-bg;
            border-width: 1px;
            border-color: #ffffff1f;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000080;
            tip-row := HorizontalLayout {
                padding-left: 11px;
                padding-right: root.tip-key != "" ? 6px : 11px;
                spacing: 9px;
                Text {
                    text: root.tip-name;
                    color: Theme.text;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                if root.tip-key != "": Rectangle {
                    y: (30px - 20px) / 2;
                    height: 20px;
                    width: cap.preferred-width + 12px;
                    border-radius: 5px;
                    background: #ffffff12;
                    border-width: 1px;
                    border-color: #ffffff1a;
                    cap := Text {
                        text: root.tip-key;
                        color: Theme.dim-text;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
